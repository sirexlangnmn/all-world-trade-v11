# Copy this file to .env and replace every placeholder before starting the app.
# .env is gitignored and must never be committed.
#
# Generate each application secret independently with a cryptographically
# secure source, for example:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Secrets shorter than 32 characters, known defaults, and placeholder values
# make the application refuse to start.

# =====================
# DATABASE CONFIGURATION
# =====================
DB_SERVERHOST=localhost
DB_USERNAME=replace-with-database-user
DB_PASSWORD=replace-with-database-password
DB_NAME=replace-with-database-name
DB_DIALECT=mysql

# =====================
# APPLICATION CONFIGURATION
# =====================
PORT=3000
NODE_ENV=nonprod
AWT_HOSTNAME=http://localhost:3000

# =====================
# SECURITY CONFIGURATION
# =====================
API_KEY_SECRET=changeme-generate-with-crypto-random-bytes
SESSION_SECRET=changeme-generate-with-crypto-random-bytes
JWT_SECRET=changeme-generate-with-crypto-random-bytes

# CSP rollout stage. Leave true while collecting browser violations, then set
# to false to enforce Content-Security-Policy. HSTS is sent only when
# NODE_ENV=production.
CSP_REPORT_ONLY=true

# =====================
# EMAIL CONFIGURATION (SMTP)
# =====================
EMAIL_SERVERHOST=replace-with-smtp-host
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=replace-with-smtp-user
EMAIL_PASSWORD=replace-with-smtp-password
EMAIL_SENDER_ADDRESS=replace-with-sender-address

# =====================
# NOTIFICATION EMAILS
# =====================
PAYMENT_EMAIL_ADDRESS=replace-with-payment-recipient
PAYMENT_EMAIL_ADDRESS_PASSWORD=replace-with-payment-password
SUPPORT_RECEIVER_EMAIL_ADDRESS=replace-with-support-recipient
SUPPORT_RECEIVER_PASSWORD=replace-with-support-password

# =====================
# BUSINESS LIMITS
# =====================
FREE_CONTACT_LIMIT=5
